{
  "name": "@weaver/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@weaver/core": "workspace:*",
    "@weaver/db": "workspace:*",
    "@weaver/docker": "workspace:*",
    "@weaver/jobs": "workspace:*",
    "@weaver/maven": "workspace:*",
    "@weaver/npm": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@weaver/config": "workspace:*",
    "@testcontainers/valkey": "12.2.1",
    "@types/node": "26.6.5",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
