<?xml version="1.0" encoding="UTF-8"?>
<!-- A consumer of hosted and upstream artifacts through one Weaver repository (scripts/e2e/maven.sh).
     -Dweaver.repo=<url> names the repository (server id `weaver` in settings.xml); -Dlib.version picks
     the maven-lib release or snapshot; -Dupstream.* replace the upstream artifact (real upstreams). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.weaver.e2e</groupId>
  <artifactId>maven-app</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <lib.version>1.0.0</lib.version>
    <upstream.groupId>dev.weaver.e2e</upstream.groupId>
    <upstream.artifactId>upstream-lib</upstream.artifactId>
    <upstream.version>1.0.0</upstream.version>
  </properties>

  <repositories>
    <repository>
      <id>weaver</id>
      <url>${weaver.repo}</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>dev.weaver.e2e</groupId>
      <artifactId>maven-lib</artifactId>
      <version>${lib.version}</version>
    </dependency>
    <dependency>
      <groupId>${upstream.groupId}</groupId>
      <artifactId>${upstream.artifactId}</artifactId>
      <version>${upstream.version}</version>
    </dependency>
  </dependencies>
</project>
