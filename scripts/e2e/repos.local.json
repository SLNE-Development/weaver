      },
      "upstreams": [
        {
          "url": "http://registry:5000",
          "authType": "basic",
          "username": "e2e",
          "secret": "e2e-registry-pass"
        }
      ]
    },
    {
      "name": "docker-cached",
      "format": "docker",
      "kind": "mirror",
      "visibility": "private",
