{
  "repos": [
    {
      "name": "proto-hosted",
      "format": "proto",
      "kind": "hosted",
      "visibility": "private"
    },
    {
      "name": "proto-public",
      "format": "proto",
      "kind": "hosted",
      "visibility": "public"
    },
    {
      "name": "proto-mirror",
      "format": "proto",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": false
        }
      },
      "upstreams": [
        {
          "url": "http://upstream:3000/api/v1/repos/proto-upstream",
          "authType": "bearer",
          "secretEnv": "UPSTREAM_PROTO_TOKEN"
        }
      ]
    },
    {
      "name": "proto-cached",
      "format": "proto",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": true,
          "store": "s3"
        }
      },
      "upstreams": [
        {
          "url": "http://upstream:3000/api/v1/repos/proto-upstream",
          "authType": "bearer",
          "secretEnv": "UPSTREAM_PROTO_TOKEN"
        }
      ]
    },
    {
      "name": "proto-group",
      "format": "proto",
      "kind": "group",
      "visibility": "private",
      "members": [
        "proto-hosted",
        "proto-mirror"
      ]
    },
    {
      "name": "maven-hosted",
      "format": "maven",
      "kind": "hosted",
      "visibility": "private"
    },
    {
      "name": "maven-public",
      "format": "maven",
      "kind": "hosted",
      "visibility": "public"
    },
    {
      "name": "maven-mirror",
      "format": "maven",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": false
        }
      },
      "upstreams": [
        {
          "url": "http://reposilite:8080/releases",
          "authType": "basic",
          "username": "e2e",
          "secret": "e2e-reposilite-secret"
        }
      ]
    },
    {
      "name": "maven-cached",
      "format": "maven",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": true,
          "store": "s3"
        }
      },
      "upstreams": [
        {
          "url": "http://reposilite:8080/releases",
          "authType": "basic",
          "username": "e2e",
          "secret": "e2e-reposilite-secret"
        }
      ]
    },
    {
      "name": "maven-group",
      "format": "maven",
      "kind": "group",
      "visibility": "private",
      "members": [
        "maven-hosted",
        "maven-mirror"
      ]
    },
    {
      "name": "npm-hosted",
      "format": "npm",
      "kind": "hosted",
      "visibility": "private"
    },
    {
      "name": "npm-public",
