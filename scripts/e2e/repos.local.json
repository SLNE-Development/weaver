      "kind": "hosted",
      "visibility": "public"
    },
    {
      "name": "npm-mirror",
      "format": "npm",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": false
        }
      },
      "upstreams": [
        {
          "url": "http://verdaccio:4873/",
          "authType": "none"
        }
      ]
    },
    {
      "name": "npm-cached",
      "format": "npm",
      "kind": "mirror",
      "visibility": "private",
      "config": {
        "cache": {
          "enabled": true,
          "store": "s3"
        }
      },
      "upstreams": [
        {
          "url": "http://verdaccio:4873/",
          "authType": "none"
        }
      ]
    },
    {
      "name": "npm-group",
      "format": "npm",
      "kind": "group",
      "visibility": "private",
      "members": [
        "npm-hosted",
        "npm-mirror"
      ]
    },
    {
      "name": "docker-hosted",
      "format": "docker",
      "kind": "hosted",
      "visibility": "private"
    },
    {
      "name": "docker-public",
      "format": "docker",
      "kind": "hosted",
      "visibility": "public"
