        "docker-mirror"
      ]
    },
    {
      "name": "hub",
      "format": "docker",
      "kind": "mirror",
      "visibility": "public",
      "dockerRoot": true,
      "config": {
        "cache": {
          "enabled": true,
          "store": "s3"
        }
      },
      "upstreams": [
        {
          "url": "http://registry:5000",
          "authType": "basic",
          "username": "e2e",
          "secret": "e2e-registry-pass"
        }
      ]
    }
