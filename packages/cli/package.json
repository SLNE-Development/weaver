{
  "name": "@slne/weaver-cli",
  "version": "0.1.0",
  "description": "CLI for fetching .proto dependencies from a Weaver registry",
  "keywords": ["protobuf", "proto", "registry", "weaver", "cli"],
  "license": "MIT",
  "homepage": "https://github.com/SLNE-Development/weaver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLNE-Development/weaver.git",
    "directory": "packages/cli"
  },
  "bugs": { "url": "https://github.com/SLNE-Development/weaver/issues" },
  "type": "module",
  "bin": { "weaver": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.3" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@weaver/config": "workspace:*",
    "@weaver/core": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
