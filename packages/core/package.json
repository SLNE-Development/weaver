{
  "name": "@weaver/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "default": "./dist/archive.js"
    },
    "./coordinates": {
      "types": "./dist/coordinates.d.ts",
      "default": "./dist/coordinates.js"
    },
    "./cleanup-kinds": {
      "types": "./dist/cleanup/kinds.d.ts",
      "default": "./dist/cleanup/kinds.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@weaver/config": "workspace:*",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/lib-storage": "3.1154.0",
    "@bufbuild/buf": "1.74.0",
    "@weaver/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "tar": "7.5.22",
    "zod": "4.6.7"
  }
}
