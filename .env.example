# Weaver configuration. Copy to .env in the repository root (git-ignored). Every variable: /docs/self-host/config.
# Empty values count as unset.

# --- Database / queue ---
DATABASE_URL=postgres://weaver:weaver@localhost:5432/weaver
VALKEY_URL=redis://localhost:6379

# --- Storage: STORAGE_DRIVER ("local" or "s3") names the primary store (hosted content) ---
# Dual storage: set STORAGE_LOCAL_PATH AND the S3_* values; both stores are configured, hosted content goes
# to STORAGE_DRIVER, and mirrors cache to the store picked in admin Settings ("Default cache storage") or per mirror.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/storage
# A non-empty S3_BUCKET configures the S3 store and requires the other S3_* values
# (dev: the seaweedfs container from docker-compose.yml, bucket "weaver")
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Public base URL, never derived from the request. Used for OAuth callbacks, cookies, absolute links.
# http://localhost is fine for development; production MUST use the public https URL.
BETTER_AUTH_URL=http://localhost:3000
# First admin: github:<login> or discord:<user id>. Required on a fresh instance (login is OAuth-only and
# sign-up needs an invite); inert once an admin exists.
INITIAL_ADMIN=
# OAuth providers (login is OAuth only; configure at least one, each with both values).
# Callback URLs: ${BETTER_AUTH_URL}/api/auth/callback/github and ${BETTER_AUTH_URL}/api/auth/callback/discord
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- docker-compose.prod.yml only ---
POSTGRES_PASSWORD=
# APP_PORT=3000

# --- docker-compose.coolify.yml only (otherwise generated by Coolify) ---
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above override the bundled seaweedfs keys.

# --- Clients (CLI / Gradle plugin) ---
# WEAVER_URL=https://weaver.example.com
# WEAVER_TOKEN=
